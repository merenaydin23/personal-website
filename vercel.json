{
  "rewrites": [
    {
      "source": "/",
      "destination": "/home page/index.html"
    },
    {
      "source": "/projects",
      "destination": "/home page/projects.html"
    },
    {
      "source": "/blog",
      "destination": "/home page/blog.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/style.css",
      "destination": "/home page/style.css"
    },
    {
      "source": "/script.js",
      "destination": "/home page/script.js"
    },
    {
      "source": "/email-config.js",
      "destination": "/home page/email-config.js"
    },
    {
      "source": "/profile.jpg",
      "destination": "/home page/profile.jpg"
    },
    {
      "source": "/blog.js",
      "destination": "/home page/blog.js"
    },
    {
      "source": "/admin/admin.css",
      "destination": "/admin/admin.css"
    },
    {
      "source": "/admin/admin.js",
      "destination": "/admin/admin.js"
    },
    {
      "source": "/admin/config.js",
      "destination": "/admin/config.js"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/favicon.ico",
      "destination": "/home page/favicon.svg"
    },
    {
      "source": "/favicon.svg",
      "destination": "/home page/favicon.svg"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; img-src 'self' data: https:; font-src 'self' https://cdnjs.cloudflare.com data:; connect-src 'self' https://api.emailjs.com; frame-ancestors 'none';"
        }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; img-src 'self' data: https:; font-src 'self' https://cdnjs.cloudflare.com data:; connect-src 'self' https://api.emailjs.com; frame-ancestors 'self';"
        }
      ]
    }
  ],
  "cleanUrls": false,
  "trailingSlash": false
}
