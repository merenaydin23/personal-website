{
  "rewrites": [
    {
      "source": "/",
      "destination": "/home page/index.html"
    },
    {
      "source": "/projects",
      "destination": "/home page/projects.html"
    },
    {
      "source": "/blog",
      "destination": "/home page/blog.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
