{
  "rewrites": [
    {
      "source": "/",
      "destination": "/home%20page/index.html"
    },
    {
      "source": "/projects",
      "destination": "/home%20page/projects.html"
    },
    {
      "source": "/blog",
      "destination": "/home%20page/blog.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    }
  ],
  "routes": [
    {
      "src": "/home page/(.*)",
      "dest": "/home%20page/$1"
    },
    {
      "src": "/(.*\\.(css|js|jpg|png|gif|svg|ico|woff|woff2|ttf|eot))",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "cleanUrls": false,
  "trailingSlash": false
}
